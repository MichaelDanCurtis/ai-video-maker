# ===========================================
# AI Video Maker - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials to version control

# ===========================================
# OpenRouter API Configuration (Required)
# ===========================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===========================================
# Default Model Configuration (Optional)
# ===========================================
# Default models for each generation type
# See available models at: https://openrouter.ai/models
DEFAULT_IMAGE_MODEL=openai/dall-e-3
DEFAULT_VIDEO_MODEL=stabilityai/stable-video-diffusion

# ===========================================
# LangFlow Configuration (Optional)
# ===========================================
# Enable/disable LangFlow for workflow orchestration
LANGFLOW_ENABLED=false
LANGFLOW_URL=http://localhost:7860

# ===========================================
# Backend Configuration
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true

# CORS - Allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# File Upload Configuration
# ===========================================
# Maximum file size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# Allowed file types for upload
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# ===========================================
# Rate Limiting (Optional)
# ===========================================
# Requests per minute per client
RATE_LIMIT_RPM=60
