# ===========================================
# AI Video Maker - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials to version control

# ===========================================
# Local MLX Inference (Recommended on Mac M-series)
# ===========================================
# mlx = run uncensored models locally on Apple Silicon
# openrouter = cloud API (requires key below)
INFERENCE_BACKEND=mlx
MLX_ENABLED=true
MLX_PYTHON=/absolute/path/to/ai-video-maker/backend/.venv-mlx/bin/python
MLX_MODELS_DIR=backend/mlx_models/weights
DATA_DIR=data
HF_HOME=
MEDIA_URL_PREFIX=/media
MLX_WORKER_POLL_SECONDS=2
MLX_JOB_TIMEOUT_SECONDS=3600

# ===========================================
# OpenRouter API Configuration (Optional cloud fallback)
# ===========================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===========================================
# Default Model Configuration
# ===========================================
# Registry IDs when INFERENCE_BACKEND=mlx:
DEFAULT_IMAGE_MODEL=flux-dev-uncensored-q4
DEFAULT_VIDEO_MODEL=wan22-i2v-lightning

# ===========================================
# LangFlow Configuration (Optional)
# ===========================================
LANGFLOW_ENABLED=false
LANGFLOW_URL=http://localhost:7860

# ===========================================
# Backend Configuration
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true

# CORS - Allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# File Upload Configuration
# ===========================================
MAX_UPLOAD_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# ===========================================
# Rate Limiting (Optional)
# ===========================================
RATE_LIMIT_RPM=60